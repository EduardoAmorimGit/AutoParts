DB_URL=jdbc:postgresql://localhost:5433/autoparts
DB_USERNAME=autoparts
DB_PASSWORD=autoparts

# Administrador inicial: criado na primeira execução se ainda não existir nenhum admin.
# NUNCA use estes valores em produção (com o perfil prod a aplicação não sobe com a senha padrão).
ADMIN_EMAIL=admin@autoparts.local
ADMIN_PASSWORD=admin

# Chave HMAC dos JWT (mínimo 32 bytes). Vazia em dev: chave aleatória, tokens expiram a cada restart.
# Obrigatória com o perfil prod. Gere com: openssl rand -base64 48
JWT_SECRET=

# Simples API (consulta de veículo por placa). Obtenha a chave no dashboard
# em https://simplesapi.com.br. Sem chave, o endpoint de lookup responde 503.
# NUNCA versione a chave real.
SIMPLES_API_KEY=

# Limite de consultas pagas ao provedor por IP (veículos já salvos não contam).
VEHICLE_LOOKUP_RATE_LIMIT=10
VEHICLE_LOOKUP_RATE_WINDOW=1m
