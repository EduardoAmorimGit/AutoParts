DB_URL=jdbc:postgresql://localhost:5433/autoparts
DB_USERNAME=autoparts
DB_PASSWORD=autoparts

# Credenciais de desenvolvimento para operações de escrita em /api/products.
# Leitura (GET) é pública. NUNCA use estes valores em produção.
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Simples API (consulta de veículo por placa). Obtenha a chave no dashboard
# em https://simplesapi.com.br. Sem chave, o endpoint de lookup responde 503.
# NUNCA versione a chave real.
SIMPLES_API_KEY=
