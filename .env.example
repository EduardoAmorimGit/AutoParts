DB_URL=jdbc:postgresql://localhost:5433/autoparts
DB_USERNAME=autoparts
DB_PASSWORD=autoparts

# Administrador inicial: criado na primeira execução se ainda não existir nenhum admin.
# NUNCA use estes valores em produção (com o perfil prod a aplicação não sobe com a senha padrão).
ADMIN_EMAIL=admin@autoparts.local
ADMIN_PASSWORD=admin

# Chave HMAC dos JWT (mínimo 32 bytes). Vazia em dev: chave aleatória, tokens expiram a cada restart.
# Obrigatória com o perfil prod. Gere com: openssl rand -base64 48
JWT_SECRET=

# Simples API (consulta de veículo por placa). Obtenha a chave no dashboard
# em https://simplesapi.com.br. Sem chave, o endpoint de lookup responde 503.
# NUNCA versione a chave real.
SIMPLES_API_KEY=

# Limite de consultas pagas ao provedor por IP (veículos já salvos não contam).
VEHICLE_LOOKUP_RATE_LIMIT=10
VEHICLE_LOOKUP_RATE_WINDOW=1m

# Mercado Pago (credenciais de TESTE em desenvolvimento; nunca versione as reais).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública para notificações (opcional; também pode ser configurada no painel).
MERCADOPAGO_NOTIFICATION_URL=

# E-mail via Brevo (SMTP relay): Brevo > SMTP & API > SMTP. O login tem o formato xxx@smtp-brevo.com
# e a senha é a "SMTP key". Sem login/chave os e-mails são apenas registrados no log.
# MAIL_FROM precisa ser um remetente (ou domínio) validado no Brevo.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
MAIL_FROM=
MAIL_FROM_NAME=AutoParts

# Identificação da loja exigida pelo Decreto 7.962/2013 (aparece nos e-mails e na política).
# Obrigatória em produção: com o perfil prod a aplicação não sobe sem razão social, CNPJ, endereço e e-mail.
STORE_NAME=AutoParts
STORE_LEGAL_NAME=
STORE_CNPJ=
STORE_ADDRESS=
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
STORE_SITE_URL=
